# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 완료/재추첨 시 입력하는 관리자 키 (미설정 시 "hs")
ADMIN_KEY=hs

# 카카오 REST API 키 (선택). restaurants.json이 비어 있을 때 실시간 검색에 사용
# KAKAO_REST_API_KEY=

# 기본 위치 이름. 카카오 키가 있으면 이 이름으로 좌표를 검색
# DEFAULT_PLACE_QUERY=더존을지타워
# 기본 위치 좌표를 직접 고정 (경도/위도)
# DEFAULT_ORIGIN_X=
# DEFAULT_ORIGIN_Y=

# Upstash Redis에 저장하려면 (무료 호스팅처럼 파일이 보존되지 않는 곳용). 없으면 DATA_DIR의 파일에 저장
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# PC에서 npm run upload-places로 가게 목록을 올릴 배포 주소
# EATZY_URL=https://eatzy-xxxx.onrender.com

# 가게 목록 파일 경로 (기본: ./restaurants.json)
# RESTAURANTS_FILE=
# 투표 데이터 저장 폴더 (클라우드에서는 영구 디스크 경로로 지정)
# DATA_DIR=/data
