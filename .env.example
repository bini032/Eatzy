# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키 (필수)
KAKAO_REST_API_KEY=
# 완료/재추첨 시 입력하는 관리자 키 (미설정 시 "hs")
ADMIN_KEY=hs
# 기본 기준 위치 (카카오 장소 검색 첫 결과의 좌표 사용)
