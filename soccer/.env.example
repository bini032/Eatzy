# 팀 편집 비밀번호: 전략 제시자가 처음 계정을 등록할 때만 필요. 꼭 바꾸세요. 없으면 기본값 "soccer"
EDIT_PASSWORD=
# 모든 전술을 고칠 수 있는 관리자 이름 (쉼표로 구분, 예: 감독,코치)
ADMIN_NAMES=
# 보기 화면 위쪽에 보일 팀 이름 기본값 (앱에서 바꿀 수 있음)
TEAM_NAME=
# 무료 호스팅(Render 등)은 파일이 보존되지 않으므로 Upstash Redis에 저장 (README 참고)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Eatzy와 같은 Upstash DB를 써도 되도록 키 이름을 따로 씀
REDIS_KEY=soccer:state
